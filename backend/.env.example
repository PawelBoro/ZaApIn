# Copy to .env and fill in real values. Never commit .env.
# Azure PostgreSQL (TLS required). Use the zaapin_dev database in development.
DATABASE_URL=postgresql://USER:PASSWORD@HOST.postgres.database.azure.com:5432/zaapin_dev?sslmode=require
PORT=3000
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
TOKEN_TTL_SECONDS=3600
