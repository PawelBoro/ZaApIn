# Copy this file to .env and fill in the values. Never commit .env.

# --- Server ---
PORT=3000

# --- Database (Azure PostgreSQL, TLS required) ---
DB_HOST=your-server.postgres.database.azure.com
DB_PORT=5432
DB_NAME=postgres-test
DB_USER=your-login@example.edu

# --- Database auth ---
# entra    = no password; a token is fetched via `az login`
# password = use DB_PASSWORD below
DB_AUTH=entra
DB_PASSWORD=

# --- Admin account (used by `npm run create-admin`) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# --- Admin session token lifetime, in seconds ---
TOKEN_TTL_SECONDS=3600
